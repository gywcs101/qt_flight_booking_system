/* ======================================================== */
/* 1. 背景图设置 (只针对最外层窗口)                         */
/* ======================================================== */
/* 注意：请确保你的 UI 文件里，最顶层的窗口 objectName 叫 LoginWidget */
#LoginWidget, #RegisterWidget, #ResetPasswordWidget {
    border-image: url(:/LoginBackGround.png);
}

/* ======================================================== */
/* 2. 防污染重置 (关键步骤！)                               */
/* ======================================================== */
/* 强制 LoginWidget 里面的所有子控件，都不许继承背景图 */
#LoginWidget *, #RegisterWidget *, #ResetPasswordWidget * {
    border-image: none;
}

/* ======================================================== */
/* 3. 标签 (QLabel) 修复                                    */
/* ======================================================== */
QLabel {
    border: none;                  /* 去掉边框 */
    background: transparent;       /* 背景透明 */
    color: #000000;                /* 【强制黑色】防止系统主题干扰 */
    font-weight: bold;             /* 加粗 */
    font-family: "Microsoft YaHei";
    font-size: 14px;               /* 设定一个基础字号，防止太小 */
}

/* ======================================================== */
/* 4. 输入框 (QLineEdit)                                    */
/* ======================================================== */
QLineEdit {
    background-color: rgba(255, 255, 255, 0.9); /* 半透明白底 */
    border: 1px solid #DCDFE6;
    border-radius: 4px;
    padding: 6px;
    color: #333333;                /* 输入文字颜色：深灰 */
}
QLineEdit:focus {
    border: 1px solid #409EFF;
}

/* ======================================================== */
/* 5. 按钮 (QPushButton)                                    */
/* ======================================================== */
QPushButton {
    background-color: #409EFF;
    color: white;                  /* 按钮文字颜色：白 */
    border-radius: 4px;
    padding: 8px;
    border: none;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #66b1ff;
}
QPushButton:pressed {
    background-color: #3a8ee6;
}

/* 取消按钮单独设置 */
#btn_cancel {
    background-color: #F56C6C;
}
#btn_cancel:hover {
    background-color: #f78989;
}

/* 注册链接按钮 */
#btn_register {
    background-color: transparent;
    color: #409EFF; /* 蓝色文字 */
    text-align: right;
}
#btn_register:hover {
    text-decoration: underline;
}
