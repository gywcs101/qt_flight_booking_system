/* =================================================================== */
/*                          1. 全局与字体设置                          */
/* =================================================================== */
* {
    font-family: "Microsoft YaHei", "微软雅黑", sans-serif;
}

/* =================================================================== */
/*               2. 登录/注册/重置密码窗口的专属样式                   */
/* =================================================================== */
#LoginWidget, #RegisterWidget, #ResetPasswordWidget {
    border-image: url(:/LoginBackGround.png);
}
#LoginWidget *, #RegisterWidget *, #ResetPasswordWidget * {
    border-image: none;
}

/* =================================================================== */
/*                   3. 通用控件样式 (全局应用)                        */
/* =================================================================== */

/* 3.1. 标签 (QLabel) */
QLabel {
    background: transparent;
    color: #303133;
    font-weight: bold;
    font-size: 14px;
}

/* 3.2. 输入框 (QLineEdit) */
QLineEdit {
    background-color: white;
    border: 1px solid #DCDFE6;
    border-radius: 4px;
    padding: 6px 8px;
    color: #333333;
}
QLineEdit:focus {
    border-color: #409EFF;
}

/* 3.3. 按钮 (QPushButton) */
/* --- 这是所有按钮的【默认】样式 --- */
QPushButton {
    background-color: #409EFF; /* 主题蓝 */
    color: white;
    border-radius: 4px;
    padding: 8px 16px;
    border: none;
    font-weight: bold;
    min-height: 20px;
    min-width: 60px;
}
QPushButton:hover {
    background-color: #66b1ff;
}
QPushButton:pressed {
    background-color: #3a8ee6;
}

/* --- [核心修改] 特殊化按钮样式 --- */

/* 3.3.1. 为所有 objectName 是 'btn_cancel' 的按钮设置红色样式 */
QPushButton#btn_cancel {
    background-color: #F56C6C; /* 红色 */
}
QPushButton#btn_cancel:hover {
    background-color: #f78989;
}
QPushButton#btn_cancel:pressed {
    background-color: #f54a4a;
}

/* 3.3.2. 【只】为登录窗口里的 'btn_register' 设置链接样式 */
/* 使用父子选择器，确保这条规则的范围被限定在 LoginWidget 内部 */
#LoginWidget QPushButton#btn_register {
    background-color: transparent;
    color: #409EFF;
    text-align: right;
    font-weight: normal;
    padding: 0;
    border: none;
}
#LoginWidget QPushButton#btn_register:hover {
    text-decoration: underline;
    color: #66b1ff;
}
#LoginWidget QPushButton#btn_register:pressed {
    color: #3a8ee6;
}

/* 4.5. 表格 (QTableWidget) 样式 */
QTableWidget {
    border: 1px solid #EBEEF5;
    gridline-color: #EBEEF5; /* 表格线颜色 */
    background-color: white;
    /* 移除这里的 selection-background-color 和 selection-color，
       我们将用更精确的选择器来控制它们 */
}

QHeaderView::section { /* 表头样式 */
    background-color: #F5F7FA;
    padding: 10px;
    border: none;
    font-weight: bold;
    color: #909399;
}

QTableWidget::item {
    padding-left: 10px;
    border: none; /* 保持单元格无边框 */
    /* 默认状态下的文字颜色，会被全局 QLabel 的 color 继承，
       所以这里通常不需要再设置 color */
}


/* [核心修改] 使用 ::item:selected 伪状态选择器来分别控制选中项的背景和文字颜色 */
QTableWidget::item:selected {
    background-color: #ECF5FF; /* ★ 设置选中项的【背景】为淡蓝色 */
    color: #303133;            /* ★ 设置选中项的【文字】为深灰色 */
}
